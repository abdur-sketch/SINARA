generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

enum EmployeeInternalStatus {
  GTY
  CGTY
  GTTY
  TENDIK
  TENAGA_PESANTREN
}

enum EmploymentRelationship {
  PERMANENT
  FIXED_TERM
  PART_TIME
  FREELANCE
  OTHER
}

enum DocumentType {
  APPOINTMENT_DECREE
  CONTRACT
  DIPLOMA
  CERTIFICATE
  ASSIGNMENT
}

enum DocumentScanStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CompensationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum PayComponentType {
  BASE_SALARY
  FIXED_ALLOWANCE
  VARIABLE_ALLOWANCE
  POSITION_ALLOWANCE
  ADDITIONAL_DUTY
  ATTENDANCE_INCENTIVE
  PERFORMANCE_INCENTIVE
  UNIT_OR_HOURLY_HONORARIUM
  CORRECTION
}

enum CalculationMethod {
  FIXED
  PERCENTAGE
  UNIT_RATE
  MANUAL
}

enum CompensationScenario {
  BASELINE
  CONSERVATIVE
  GROWTH
  CUSTOM
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  SICK
  PERMISSION
  OFFICIAL_DUTY
  HOLIDAY
}

enum AttendanceSource {
  WEB
  ADMIN
  IMPORT
  DEVICE
}

enum AttendanceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Organization {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  code                    String                   @unique
  isActive                Boolean                  @default(true) @map("is_active")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  units                   Unit[]
  employees               Employee[]
  positions               Position[]
  users                   User[]
  roles                   Role[]
  auditLogs               AuditLog[]
  compensationFactors     CompensationFactor[]
  jobGrades               JobGrade[]
  jobEvaluations          JobEvaluation[]
  salaryPolicies          SalaryPolicy[]
  payComponents           PayComponent[]
  compensationProposals   CompensationProposal[]
  compensationSimulations CompensationSimulation[]
  compensationApprovals   CompensationApproval[]
  workSchedules           WorkSchedule[]
  holidays                Holiday[]
  attendanceRecords       AttendanceRecord[]
  attendanceCorrections   AttendanceCorrection[]
  leaveTypes              LeaveType[]
  leaveRequests           LeaveRequest[]

  @@map("organizations")
}

model Unit {
  id                      String                       @id @default(uuid()) @db.Uuid
  organizationId          String                       @map("organization_id") @db.Uuid
  name                    String
  code                    String
  type                    String
  isActive                Boolean                      @default(true) @map("is_active")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryEmployees        Employee[]
  assignments             EmployeeAssignment[]
  compensationAllocations CompensationCostAllocation[]
  workSchedules           WorkSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("units")
}

model Employee {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  employeeNumber        String                   @map("employee_number")
  fullName              String                   @map("full_name")
  gender                Gender
  birthDate             DateTime?                @map("birth_date") @db.Date
  email                 String?
  phone                 String?
  address               String?
  lastEducation         String?                  @map("last_education")
  competencies          String?
  startDate             DateTime                 @map("start_date") @db.Date
  internalStatus        EmployeeInternalStatus   @map("internal_status")
  primaryUnitId         String                   @map("primary_unit_id") @db.Uuid
  isActive              Boolean                  @default(true) @map("is_active")
  archivedAt            DateTime?                @map("archived_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryUnit           Unit                     @relation(fields: [primaryUnitId], references: [id], onDelete: Restrict)
  contracts             EmploymentContract[]
  assignments           EmployeeAssignment[]
  documents             EmployeeDocument[]
  user                  User?
  compensationProposals CompensationProposal[]
  scheduleAssignments   WorkScheduleAssignment[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, isActive])
  @@index([primaryUnitId])
  @@map("employees")
}

model EmploymentContract {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  employeeId       String                 @map("employee_id") @db.Uuid
  relationshipType EmploymentRelationship @map("relationship_type")
  startDate        DateTime               @map("start_date") @db.Date
  endDate          DateTime?              @map("end_date") @db.Date
  notes            String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, endDate])
  @@index([employeeId])
  @@map("employment_contracts")
}

model Position {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  code           String
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    EmployeeAssignment[]
  jobEvaluations JobEvaluation[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("positions")
}

model EmployeeAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  unitId         String    @map("unit_id") @db.Uuid
  positionId     String    @map("position_id") @db.Uuid
  isPrimary      Boolean   @default(false) @map("is_primary")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  position       Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId])
  @@index([unitId, effectiveTo])
  @@map("employee_assignments")
}

model EmployeeDocument {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  employeeId     String             @map("employee_id") @db.Uuid
  type           DocumentType
  title          String
  storageKey     String             @unique @map("storage_key")
  originalName   String             @map("original_name")
  mimeType       String             @map("mime_type")
  sizeBytes      Int                @map("size_bytes")
  scanStatus     DocumentScanStatus @default(PENDING) @map("scan_status")
  scanNote       String?            @map("scan_note")
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy     User?              @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  employeeId             String?                  @unique @map("employee_id") @db.Uuid
  email                  String                   @unique
  name                   String
  passwordHash           String                   @map("password_hash")
  isActive               Boolean                  @default(true) @map("is_active")
  mfaEnabled             Boolean                  @default(false) @map("mfa_enabled")
  mfaSecretEncrypted     String?                  @map("mfa_secret_encrypted")
  mfaPendingEncrypted    String?                  @map("mfa_pending_encrypted")
  mfaRecoveryHashes      Json?                    @map("mfa_recovery_hashes")
  mfaFailedAttempts      Int                      @default(0) @map("mfa_failed_attempts")
  mfaLockedUntil         DateTime?                @map("mfa_locked_until")
  failedLoginAttempts    Int                      @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime?                @map("locked_until")
  passwordResetHash      String?                  @map("password_reset_hash")
  passwordResetExpiry    DateTime?                @map("password_reset_expiry")
  sessionVersion         Int                      @default(1) @map("session_version")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee               Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles                  UserRole[]
  auditLogs              AuditLog[]               @relation("ActorAuditLogs")
  authChallenges         AuthChallenge[]
  reviewedDocuments      EmployeeDocument[]       @relation("DocumentReviewer")
  createdJobEvaluations  JobEvaluation[]          @relation("JobEvaluationCreator")
  reviewedJobEvaluations JobEvaluation[]          @relation("JobEvaluationReviewer")
  proposedCompensations  CompensationProposal[]   @relation("CompensationProposer")
  reviewedCompensations  CompensationProposal[]   @relation("CompensationReviewer")
  createdSimulations     CompensationSimulation[] @relation("SimulationCreator")
  compensationApprovals  CompensationApproval[]   @relation("CompensationApprover")
  createdSalaryPolicies  SalaryPolicy[]           @relation("SalaryPolicyCreator")
  manualAttendance       AttendanceRecord[]       @relation("AttendanceManualCreator")
  requestedCorrections   AttendanceCorrection[]   @relation("AttendanceCorrectionRequester")
  reviewedCorrections    AttendanceCorrection[]   @relation("AttendanceCorrectionReviewer")
  requestedLeave         LeaveRequest[]           @relation("LeaveRequester")
  reviewedLeave          LeaveRequest[]           @relation("LeaveReviewer")

  @@index([organizationId, isActive])
  @@map("users")
}

model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  purpose    String
  verified   Boolean   @default(false)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_challenges")
}

model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("rate_limit_buckets")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorId        String?       @map("actor_id") @db.Uuid
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id")
  metadata       Json?
  ipAddress      String?       @map("ip_address")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model CompensationFactor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  name           String
  weight         Decimal      @db.Decimal(5, 2)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@map("compensation_factors")
}

model JobGrade {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  code           String
  name           String
  level          Int
  minimumScore   Decimal                @map("minimum_score") @db.Decimal(6, 2)
  maximumScore   Decimal                @map("maximum_score") @db.Decimal(6, 2)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evaluations    JobEvaluation[]
  salaryScales   SalaryScale[]
  proposals      CompensationProposal[]

  @@unique([organizationId, code])
  @@unique([organizationId, level])
  @@index([organizationId, isActive])
  @@map("job_grades")
}

model JobEvaluation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  positionId     String             @map("position_id") @db.Uuid
  jobGradeId     String?            @map("job_grade_id") @db.Uuid
  responsibility Int
  competency     Int
  complexity     Int
  impact         Int
  independence   Int
  weightedScore  Decimal            @map("weighted_score") @db.Decimal(6, 2)
  status         CompensationStatus @default(DRAFT)
  reviewerNotes  String?            @map("reviewer_notes")
  createdById    String             @map("created_by_id") @db.Uuid
  reviewedById   String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at")
  effectiveDate  DateTime           @map("effective_date") @db.Date
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  position       Position           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobGrade       JobGrade?          @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("JobEvaluationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy     User?              @relation("JobEvaluationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([organizationId, positionId, effectiveDate])
  @@map("job_evaluations")
}

model SalaryPolicy {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  name              String
  version           Int
  periodStart       DateTime                 @map("period_start") @db.Date
  periodEnd         DateTime?                @map("period_end") @db.Date
  effectiveDate     DateTime                 @map("effective_date") @db.Date
  status            CompensationStatus       @default(DRAFT)
  scopeKey          String                   @default("ORGANIZATION") @map("scope_key")
  minimumWageConfig Json?                    @map("minimum_wage_config")
  changeNotes       String?                  @map("change_notes")
  createdById       String                   @map("created_by_id") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy         User                     @relation("SalaryPolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scales            SalaryScale[]
  proposals         CompensationProposal[]
  simulations       CompensationSimulation[]

  @@unique([organizationId, name, version])
  @@index([organizationId, status, effectiveDate])
  @@map("salary_policies")
}

model SalaryScale {
  id         String       @id @default(uuid()) @db.Uuid
  policyId   String       @map("policy_id") @db.Uuid
  jobGradeId String       @map("job_grade_id") @db.Uuid
  minimum    Decimal      @db.Decimal(18, 2)
  midpoint   Decimal      @db.Decimal(18, 2)
  maximum    Decimal      @db.Decimal(18, 2)
  currency   String       @default("IDR")
  basisNotes String?      @map("basis_notes")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  policy     SalaryPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  jobGrade   JobGrade     @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)

  @@unique([policyId, jobGradeId])
  @@map("salary_scales")
}

model PayComponent {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  code           String
  name           String
  type           PayComponentType
  method         CalculationMethod
  defaultValue   Decimal?                   @map("default_value") @db.Decimal(18, 2)
  effectiveDate  DateTime                   @map("effective_date") @db.Date
  isActive       Boolean                    @default(true) @map("is_active")
  legalNotes     String?                    @map("legal_notes")
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  proposalItems  CompensationProposalItem[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive, effectiveDate])
  @@map("pay_components")
}

model CompensationProposal {
  id              String                       @id @default(uuid()) @db.Uuid
  organizationId  String                       @map("organization_id") @db.Uuid
  employeeId      String                       @map("employee_id") @db.Uuid
  jobGradeId      String                       @map("job_grade_id") @db.Uuid
  salaryPolicyId  String                       @map("salary_policy_id") @db.Uuid
  salaryPlacement Decimal                      @map("salary_placement") @db.Decimal(18, 2)
  effectiveDate   DateTime                     @map("effective_date") @db.Date
  reason          String
  status          CompensationStatus           @default(DRAFT)
  proposedById    String                       @map("proposed_by_id") @db.Uuid
  reviewedById    String?                      @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?                    @map("reviewed_at")
  idempotencyKey  String                       @map("idempotency_key")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee        Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobGrade        JobGrade                     @relation(fields: [jobGradeId], references: [id], onDelete: Restrict)
  salaryPolicy    SalaryPolicy                 @relation(fields: [salaryPolicyId], references: [id], onDelete: Restrict)
  proposedBy      User                         @relation("CompensationProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  reviewedBy      User?                        @relation("CompensationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  items           CompensationProposalItem[]
  allocations     CompensationCostAllocation[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, employeeId, effectiveDate])
  @@map("compensation_proposals")
}

model CompensationProposalItem {
  id             String               @id @default(uuid()) @db.Uuid
  proposalId     String               @map("proposal_id") @db.Uuid
  payComponentId String               @map("pay_component_id") @db.Uuid
  amount         Decimal              @db.Decimal(18, 2)
  quantity       Decimal              @default(1) @db.Decimal(10, 2)
  notes          String?
  proposal       CompensationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  payComponent   PayComponent         @relation(fields: [payComponentId], references: [id], onDelete: Restrict)

  @@unique([proposalId, payComponentId])
  @@map("compensation_proposal_items")
}

model CompensationCostAllocation {
  id           String               @id @default(uuid()) @db.Uuid
  proposalId   String               @map("proposal_id") @db.Uuid
  unitId       String               @map("unit_id") @db.Uuid
  percentage   Decimal              @db.Decimal(5, 2)
  periodStart  DateTime             @map("period_start") @db.Date
  periodEnd    DateTime?            @map("period_end") @db.Date
  isIncomplete Boolean              @default(false) @map("is_incomplete")
  proposal     CompensationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  unit         Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([proposalId, unitId, periodStart])
  @@map("compensation_cost_allocations")
}

model CompensationSimulation {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  salaryPolicyId    String?              @map("salary_policy_id") @db.Uuid
  name              String
  scenario          CompensationScenario
  periodStart       DateTime             @map("period_start") @db.Date
  periodEnd         DateTime             @map("period_end") @db.Date
  assumptions       Json
  results           Json
  totalBaseSalary   Decimal              @map("total_base_salary") @db.Decimal(18, 2)
  totalAllowances   Decimal              @map("total_allowances") @db.Decimal(18, 2)
  totalCompensation Decimal              @map("total_compensation") @db.Decimal(18, 2)
  employerCost      Decimal              @map("employer_cost") @db.Decimal(18, 2)
  idempotencyKey    String               @map("idempotency_key")
  createdById       String               @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salaryPolicy      SalaryPolicy?        @relation(fields: [salaryPolicyId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation("SimulationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@map("compensation_simulations")
}

model CompensationApproval {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  action         String
  notes          String?
  actorId        String       @map("actor_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User         @relation("CompensationApprover", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("compensation_approvals")
}

model WorkSchedule {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  unitId            String?                  @map("unit_id") @db.Uuid
  code              String
  name              String
  timezone          String                   @default("Asia/Jakarta")
  workDays          Int[]                    @map("work_days")
  startMinute       Int                      @map("start_minute")
  endMinute         Int                      @map("end_minute")
  breakMinutes      Int                      @default(60) @map("break_minutes")
  lateTolerance     Int                      @default(0) @map("late_tolerance")
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  unit              Unit?                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  assignments       WorkScheduleAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, code])
  @@index([organizationId, unitId, isActive])
  @@map("work_schedules")
}

model WorkScheduleAssignment {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  scheduleId    String       @map("schedule_id") @db.Uuid
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([scheduleId, effectiveTo])
  @@map("work_schedule_assignments")
}

model Holiday {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  date           DateTime     @db.Date
  name           String
  isCollective   Boolean      @default(false) @map("is_collective")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, date])
  @@map("holidays")
}

model AttendanceRecord {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  employeeId          String                 @map("employee_id") @db.Uuid
  scheduleId          String?                @map("schedule_id") @db.Uuid
  date                DateTime               @db.Date
  checkInAt           DateTime?              @map("check_in_at")
  checkOutAt          DateTime?              @map("check_out_at")
  status              AttendanceStatus       @default(PRESENT)
  source              AttendanceSource       @default(WEB)
  lateMinutes         Int                    @default(0) @map("late_minutes")
  workMinutes         Int                    @default(0) @map("work_minutes")
  notes               String?
  manuallyCreatedById String?                @map("manually_created_by_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee            Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  schedule            WorkSchedule?          @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  manuallyCreatedBy   User?                  @relation("AttendanceManualCreator", fields: [manuallyCreatedById], references: [id], onDelete: SetNull)
  corrections         AttendanceCorrection[]

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date, status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  recordId           String?                 @map("record_id") @db.Uuid
  employeeId         String                  @map("employee_id") @db.Uuid
  date               DateTime                @db.Date
  proposedCheckInAt  DateTime?               @map("proposed_check_in_at")
  proposedCheckOutAt DateTime?               @map("proposed_check_out_at")
  reason             String
  status             AttendanceRequestStatus @default(PENDING)
  requestedById      String                  @map("requested_by_id") @db.Uuid
  reviewedById       String?                 @map("reviewed_by_id") @db.Uuid
  reviewerNotes      String?                 @map("reviewer_notes")
  reviewedAt         DateTime?               @map("reviewed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  record             AttendanceRecord?       @relation(fields: [recordId], references: [id], onDelete: Restrict)
  employee           Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestedBy        User                    @relation("AttendanceCorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy         User?                   @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([employeeId, date])
  @@map("attendance_corrections")
}

model LeaveType {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  code               String
  name               String
  annualQuota        Int?           @map("annual_quota")
  requiresAttachment Boolean        @default(false) @map("requires_attachment")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  balances           LeaveBalance[]
  requests           LeaveRequest[]

  @@unique([organizationId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  year        Int
  allowance   Int
  used        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  employeeId     String                  @map("employee_id") @db.Uuid
  leaveTypeId    String                  @map("leave_type_id") @db.Uuid
  startDate      DateTime                @map("start_date") @db.Date
  endDate        DateTime                @map("end_date") @db.Date
  workDays       Int                     @map("work_days")
  reason         String
  attachmentRef  String?                 @map("attachment_ref")
  status         AttendanceRequestStatus @default(PENDING)
  requestedById  String                  @map("requested_by_id") @db.Uuid
  reviewedById   String?                 @map("reviewed_by_id") @db.Uuid
  reviewerNotes  String?                 @map("reviewer_notes")
  reviewedAt     DateTime?               @map("reviewed_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee       Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType      LeaveType               @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  requestedBy    User                    @relation("LeaveRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                   @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, startDate])
  @@index([employeeId, startDate, endDate])
  @@map("leave_requests")
}
